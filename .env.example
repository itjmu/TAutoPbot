BOT_TOKEN=
ADMIN_ID=0
DB_FILE=bot.db
STARS_7_DAYS=100
STARS_30_DAYS=300
# Maximum source size per video; output video parts are always <= 49 MB.
DOWNLOAD_SOURCE_BYTES=1000000000
DOWNLOAD_TOTAL_BYTES=4000000000
# Optional binaries; otherwise bundled FFmpeg / PATH Deno are used.
FFMPEG_PATH=
DENO_PATH=
# Optional Netscape cookies file for Instagram; relative to the project directory.
INSTAGRAM_COOKIES_FILE=
# Shared Netscape file for other supported sites; site-specific files take priority.
DOWNLOAD_COOKIES_FILE=
TIKTOK_COOKIES_FILE=
YOUTUBE_COOKIES_FILE=
TWITTER_COOKIES_FILE=
FACEBOOK_COOKIES_FILE=
VK_COOKIES_FILE=
REDDIT_COOKIES_FILE=
# Optional Linux filesystem sandbox: 'required' fails closed if bubblewrap is unavailable.
# Windows keeps the existing subprocess isolation; this setting must remain off there.
DOWNLOAD_SANDBOX=off
# Worker resource ceilings: Linux process limits; Windows Job Object family limits.
DOWNLOAD_WORKER_CPU_SECONDS=1800
DOWNLOAD_WORKER_MEMORY_BYTES=2147483648
